// ───────────────────────────────────────────────────────────────────────────
// Klaska database schema (Prisma + PostgreSQL/Neon)
//
// Every `model` below becomes a real table in your Postgres database. Prisma
// reads this file to (a) generate a fully type-safe client you call from code,
// and (b) create/alter the actual tables via migrations.
//
// The shape is multi-tenant: one School owns its Staff, Classes and Students.
// A logged-in user is a Staff member, so the school's data is always scoped by
// schoolId — School A can never see School B's records.
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection — used by the running app (many short-lived queries).
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma migrate` to change the schema.
  directUrl = env("DIRECT_URL")
}

// The six v1 staff roles (Product Structure §2). Role decides the view.
enum Role {
  OWNER // Proprietor — sees everything incl. money & settings
  HOS // Principal / Head of School — runs academics
  BURSAR // Accountant — runs the money
  HOD // Head of Department — their department only
  TEACHER // their assigned classes only; never sees money
  ADMIN // Admin Officer — front desk: records, no money, no scores
}

// A student's enrolment status. Records are never deleted — status is set instead (§3).
enum StudentStatus {
  ACTIVE
  GRADUATED
  LEFT
}

// Timeline events on a student's journey (§6 "never deleted, full history").
enum StudentEventType {
  ENROLLED
  PROMOTED
  REPEATED
  GRADUATED
  LEFT
  TRANSFERRED
  REINSTATED
}

// A school = one tenant/account. The first person to sign up becomes its OWNER.
model School {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  motto     String?
  address   String?
  email     String?
  phone     String?
  logoUrl   String?  @db.Text // small logo stored inline as a data URL
  // Which sections this school runs: EARLY | PRIMARY | JUNIOR | SENIOR.
  sections         String[]  @default([])
  setupCompletedAt DateTime? // null until the onboarding wizard is finished
  // Nigerian academic calendar — auto-detected at setup, editable in Settings.
  session   String? // e.g. "2025/2026"
  term      String? // FIRST | SECOND | THIRD
  termStart DateTime?
  termEnd   DateTime?
  // Fee collection preferences. Virtual (bank/virtual-account) tracking lands later.
  feeCollection    String  @default("MANUAL") // MANUAL | VIRTUAL
  autoFeeReminders Boolean @default(false)
  // Tiering (feature flags): BASIC = small schools, ENTERPRISE = operational depth.
  tier        String  @default("BASIC") // BASIC | ENTERPRISE
  // Multi-campus is enterprise complexity — hidden for small schools.
  multiCampus Boolean @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff        Staff[]
  classes      Class[]
  students     Student[]
  attendance   Attendance[]
  subjects     Subject[]
  results      Result[]
  gradingBands GradingBand[]
  feeItems     FeeItem[]
  notices      Notice[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  guardians    Guardian[]
  campuses     Campus[]
  sessions      Session[]
  terms         Term[]
  levels        Level[]
  departments   Department[]
  enrollments   Enrollment[]
  studentEvents StudentEvent[]
  assessments      Assessment[]
  scores           Score[]
  curriculumTopics CurriculumTopic[]
  questions        Question[]
}

// One PERSON, many children (the guardian-student decoupling). The import
// engine dedupes by normalised phone / email so "Chidi Obi", "Chidi O." and
// "Mr Obi" with the same number become ONE guardian linked to all their kids —
// the backbone for SMS + payment links.
model Guardian {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String
  phone     String?
  phoneKey  String? // digits-only, last-10 normalised — the dedup key
  email     String?
  createdAt DateTime @default(now())

  students Student[]

  @@index([schoolId, phoneKey])
  @@index([schoolId, email])
}

// School → Campus → Level hierarchy for large institutions (e.g. a Primary
// campus and a Secondary campus with distinct budgets under one Owner).
// Small schools never see this: multiCampus=false hides it entirely.
model Campus {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  classes Class[]

  @@unique([schoolId, name])
}

// A staff member. This is also the *login account* — email + password live here.
model Staff {
  id           String   @id @default(cuid())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  name         String
  email        String   @unique // used to log in; unique across the whole system
  passwordHash String // never store raw passwords — only a bcrypt hash
  role         Role     @default(TEACHER)
  title        String? // e.g. "Mathematics Teacher", "Head of Science"
  phone        String?
  salaryMonthly Int? // gross monthly salary (naira) — feeds payroll
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A teacher can be the form teacher of one or more classes.
  classesLed Class[] @relation("ClassTeacher")

  @@index([schoolId])
}

// A class/arm, e.g. "JSS 1" arm "A". Belongs to a school, may have a teacher.
model Class {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String // level, e.g. "JSS 1"
  arm       String? // stream, e.g. "A" (optional)
  teacher   Staff?   @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?
  campus    Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  campusId  String?
  level        Level?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  levelId      String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    Student[]
  attendance  Attendance[]
  classFees   ClassFee[]
  enrollments Enrollment[]

  // No two classes in the same school can share the same name + arm.
  @@unique([schoolId, name, arm])
  @@index([schoolId])
}

// A student. Belongs to a school, optionally assigned to a class.
model Student {
  id            String    @id @default(cuid())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String
  firstName     String
  lastName      String
  admissionNo   String? // e.g. "KLK-0001"
  gender        String? // "M" / "F"
  dob           DateTime?
  guardianName  String? // legacy snapshot (kept for display/back-compat)
  guardianPhone String?
  guardian      Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  guardianId    String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId       String?
  // Lifecycle — records are never deleted; status is set instead (§3).
  status          StudentStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attendance  Attendance[]
  results     Result[]
  invoices    Invoice[]
  payments    Payment[]
  enrollments Enrollment[]
  events      StudentEvent[]
  scores      Score[]

  // Admission numbers are unique within a school (not globally).
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
}

// One attendance mark per student per day. Marking a class upserts these rows.
// (Term-scoping will be added later with the Session/Term backbone.)
model Attendance {
  id         String   @id @default(cuid())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  class      Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId    String?
  date       DateTime @db.Date // the school day (no time component)
  status     String // PRESENT | ABSENT | LATE | EXCUSED
  session    String? // e.g. "2025/2026" — snapshot of the school calendar
  term       String? // FIRST | SECOND | THIRD
  recordedBy String? // staffId of whoever marked it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, date]) // a student has exactly one mark per day
  @@index([schoolId, date])
  @@index([classId, date])
}

// Subjects offered by the school (e.g. Mathematics, English).
model Subject {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String
  code      String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results   Result[]
  scores    Score[]
  topics    CurriculumTopic[]
  questions Question[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// One student's score in one subject. CA1 (/20) + CA2 (/20) + Exam (/60) →
// total (/100) → grade. total & grade are computed in the action on save.
// (Term-scoping comes later with the Session/Term backbone.)
model Result {
  id         String   @id @default(cuid())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  String
  classId    String? // snapshot of the student's class when entered (for filtering)
  ca1        Int?
  ca2        Int?
  exam       Int?
  total      Int?
  grade      String?
  session    String? // calendar snapshot — scores belong to a term (§6)
  term       String?
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, subjectId]) // one score per subject (per term, later)
  @@index([schoolId])
  @@index([subjectId, classId])
}

// The school's grading scale. Bands are grouped by category so a school can
// grade Early Years differently from Secondary. Seeded with Nigerian defaults
// during onboarding, then fully editable.
model GradingBand {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String
  category String // SECONDARY | PRIMARY | EARLY
  label    String // e.g. "A1"
  minScore Int
  maxScore Int
  remark   String // e.g. "Excellent"
  order    Int    @default(0)

  @@index([schoolId, category])
}

// A fee TYPE the school charges (e.g. Tuition, Development levy). The actual
// amount lives per-class in ClassFee, so fees can vary by class/department.
model FeeItem {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String
  mandatory Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  classFees ClassFee[]

  @@index([schoolId])
}

// ---------- Finance core (Flow 3 & 4): invoices, payments, balances ----------

// A student's bill for one term. Total is the sum of its lines (snapshotted
// from the class's fee structure at generation time, so later fee edits never
// rewrite old bills). Balance = total − payments; status is computed.
model Invoice {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  session   String // "2025/2026"
  term      String // FIRST | SECOND | THIRD
  total     Int // naira
  createdAt DateTime @default(now())

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([studentId, session, term]) // one bill per student per term
  @@index([schoolId, session, term])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String // fee item name at generation time
  amount      Int
}

// Money received (manual mode: bursar records it; virtual mode auto-matches later).
model Payment {
  id         String   @id @default(cuid())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId  String?
  amount     Int
  method     String // CASH | TRANSFER | POS
  reference  String?
  paidAt     DateTime @default(now())
  recordedBy String? // staff name

  @@index([schoolId, paidAt])
  @@index([invoiceId])
}

// Money going out — completes Flow 4 (revenue − costs = profit, live).
model Expense {
  id         String   @id @default(cuid())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  category   String // SALARIES | RENT | UTILITIES | SUPPLIES | TRANSPORT | MAINTENANCE | OTHER
  description String?
  amount     Int
  spentAt    DateTime @default(now())
  recordedBy String?

  @@index([schoolId, spentAt])
}

// A message from the school admin to staff or parents. Stored as the school's
// message log; SMS/WhatsApp/email delivery channels connect in a later phase.
model Notice {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  audience  String // ALL_STAFF | TEACHERS | BURSARS | PARENTS
  title     String?
  body      String   @db.Text
  sentBy    String // staff name at send time
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// The amount charged for a fee item in a specific class (whole naira).
model ClassFee {
  id        String  @id @default(cuid())
  schoolId  String
  feeItem   FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
  feeItemId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  amount    Int

  @@unique([feeItemId, classId])
  @@index([schoolId])
  @@index([classId])
}

// ─────────────────────── Phase 1a: academic-structure spine ──────────────────
// First-class Session/Term/Level/Department — previously string snapshots or
// implicit in class names. All additive; existing string columns stay for now
// and are dual-written during the migration, then retired in a later cleanup.

// An academic year, e.g. "2025/2026". Exactly one isCurrent per school.
model Session {
  id        String    @id @default(cuid())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String // "2025/2026"
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A term within a session (FIRST | SECOND | THIRD). Exactly one isCurrent.
model Term {
  id        String    @id @default(cuid())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  name      String // FIRST | SECOND | THIRD
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  scores Score[]

  @@unique([sessionId, name])
  @@index([schoolId])
}

// A stage the school runs (Crèche … SSS 3). `label` is the school's renamable
// display name; `name` is the canonical key used by history/promotions.
model Level {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String // canonical, e.g. "JSS 1"
  label     String? // renamable display label, e.g. "Year 7"
  section   String // EARLY | PRIMARY | JUNIOR | SENIOR
  order     Int      @default(0)
  createdAt DateTime @default(now())

  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A senior-secondary department (Science/Arts/Commercial). `label` renamable.
model Department {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String // e.g. "Science"
  label     String? // renamable
  order     Int      @default(0)
  createdAt DateTime @default(now())

  classes  Class[]
  students Student[]
  subjects Subject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A student's placement in a class for a given session — the class history that
// makes promotions and the "full journey" possible without deleting anything.
model Enrollment {
  id        String    @id @default(cuid())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  class     Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId   String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([schoolId])
  @@index([studentId])
}

// Timeline of a student's journey (enrolled, promoted, graduated, left…).
model StudentEvent {
  id        String           @id @default(cuid())
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  type      StudentEventType
  session   String? // snapshot label at the time
  term      String?
  note      String?
  createdAt DateTime         @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// ─────────────────────── Phase 1b: assessments, scores, topics ───────────────
// Score = student × subject × assessment × term (replaces Result's fixed
// ca1/ca2/exam columns). Assessments are configurable per school. Every score
// and question can be tagged to a CurriculumTopic — the field exists now
// (seeded for Maths & English) even though the UI barely surfaces it yet.

// A curriculum topic within a subject (e.g. Maths → "Fractions").
model CurriculumTopic {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  name      String // e.g. "Fractions", "Comprehension"
  code      String? // optional curriculum code
  section   String? // EARLY | PRIMARY | JUNIOR | SENIOR
  order     Int      @default(0)
  createdAt DateTime @default(now())

  scores    Score[]
  questions Question[]

  @@index([schoolId])
  @@index([subjectId])
}

// A configurable assessment component, e.g. CA1 (/20), CA2 (/20), Exam (/60).
model Assessment {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String // "CA1", "CA2", "Exam", "Project"…
  maxScore  Int      @default(100)
  weight    Int      @default(0) // % weight toward the term total
  order     Int      @default(0)
  category  String? // CA | EXAM | OTHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores    Score[]
  questions Question[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// One student's mark for one assessment, in one subject, in one term.
model Score {
  id           String   @id @default(cuid())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  term         Term?    @relation(fields: [termId], references: [id], onDelete: SetNull)
  termId       String?
  topic        CurriculumTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId      String?
  value        Int
  session      String? // snapshot label (until termId is universally set)
  termLabel    String? // FIRST | SECOND | THIRD snapshot
  recordedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, subjectId, assessmentId, termId]) // one mark per assessment/term
  @@index([schoolId])
  @@index([subjectId])
  @@index([termId])
}

// A question in a subject/assessment, tagged to a curriculum topic. Minimal for
// now — exists so AI auto-grading & topic analytics can attach to it later.
model Question {
  id           String   @id @default(cuid())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    String
  topic        CurriculumTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId      String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  assessmentId String?
  text         String   @db.Text
  answer       String?  @db.Text
  marks        Int      @default(1)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([subjectId])
  @@index([topicId])
}
